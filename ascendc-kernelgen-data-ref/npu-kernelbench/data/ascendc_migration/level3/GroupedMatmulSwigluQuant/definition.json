  "reference": "import torch\nimport torch_npu\n\ndef run(x, weight, weight_scale, x_scale, group_list):\n    e = weight.shape[0]\n    x_list = [x]\n    w_list = [weight[i] for i in range(e)]\n    ws_list = [weight_scale[i] for i in range(e)]\n    matmul_out = torch_npu.npu_grouped_matmul(x_list, w_list, scale=ws_list, group_list=group_list, group_type=0, group_list_type=0, split_item=2, output_dtype=torch.float16)\n    swiglu_out = torch_npu.npu_swiglu(matmul_out, dim=-1)\n    q_out, q_scale = torch_npu.npu_dynamic_quant(swiglu_out, dst_type=torch.int8)\n    return q_out, q_scale\n",
