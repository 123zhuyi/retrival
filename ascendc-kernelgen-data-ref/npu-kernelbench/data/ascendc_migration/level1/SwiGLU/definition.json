{
  "name": "SwiGLU",
  "op_type": "elementwise",
  "axes": {},
  "inputs": {
    "x": {
      "description": "shape varies; supports float32"
    },
    "dim": {
      "description": "int, default=-1; optional"
    }
  },
  "outputs": {
